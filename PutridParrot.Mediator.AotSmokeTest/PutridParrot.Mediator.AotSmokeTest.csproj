<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT smoke test: publish with
      dotnet publish PutridParrot.Mediator.AotSmokeTest -c Release
    and run the native executable; it exits with a non-zero code if anything fails.
    Building alone also runs the trimming and AOT analyzers, and their warnings are errors here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Report each trimming warning in referenced libraries rather than one per assembly -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PutridParrot.Mediator\PutridParrot.Mediator.csproj" />
    <ProjectReference Include="..\PutridParrot.Mediator.SourceGenerator\PutridParrot.Mediator.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
