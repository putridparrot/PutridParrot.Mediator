<Project>
  <PropertyGroup>
    <!-- Centralized version management. CI overrides this with /p:Version for releases and previews -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha</VersionSuffix>

    <!-- Common package metadata -->
    <Authors>PutridParrot</Authors>
    <Company>PutridParrot</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) PutridParrot</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/putridparrot/PutridParrot.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/putridparrot/PutridParrot.Mediator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/putridparrot/PutridParrot.Mediator/releases</PackageReleaseNotes>

    <!-- Build settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Source Link is built into the .NET 8+ SDK, so no Microsoft.SourceLink.GitHub package is needed -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Deterministic builds with normalized source paths when building in GitHub Actions -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
